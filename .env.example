# 复制为项目根目录 .env 后填写真实值。
# 数据库：本项目仅使用远程 PostgreSQL，通过 DATABASE_URL 连接（勿配置本地 MySQL）。

ENV=local
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# 必填 — 远程 PostgreSQL（asyncpg）
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE

ENABLE_AUTH=false
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# 本地 Redis（Celery broker / 缓存）
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_BACKEND_URL=redis://127.0.0.1:6379/2
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

DOCUMENT_OCR_AUTO_ENQUEUE=true
DOCUMENT_STORAGE_PROVIDER=oss

# OSS / TextIn / OpenAI — 按实际环境填写
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_REGION=
TEXTIN_APP_ID=
TEXTIN_SECRET_CODE=
TEXTIN_API_URL=https://api.textin.com/ai/service/v1/pdf_to_markdown
TEXTIN_PARSE_MODE=auto
TEXTIN_GET_IMAGE=page
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
