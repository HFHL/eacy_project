ENV=prod
DEBUG=false

# Compose runtime. docker-compose.prod.yml only starts Redis;
# PostgreSQL must be provided as an external/remote service via DATABASE_URL.

# API runtime
APP_HOST=0.0.0.0
APP_PORT=8000
ENABLE_AUTH=true
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Database. Point this at the production PostgreSQL instance.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DB_HOST:5432/DB_NAME
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=600

# Redis / Celery. DB 11/12 avoid collisions with local development defaults.
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/11
CELERY_BACKEND_URL=redis://redis:6379/12
CELERY_RESULT_BACKEND=redis://redis:6379/12
CELERY_TASK_ALWAYS_EAGER=false

# Celery Beat: daily cleanup of idle pending extraction jobs (marks failed, retryable).
STALE_PENDING_ABANDON_ENABLED=true
STALE_PENDING_ABANDON_HOURS=24
STALE_PENDING_ABANDON_LIMIT=500
STALE_PENDING_ABANDON_CRON_HOUR=3
STALE_PENDING_ABANDON_CRON_MINUTE=0

# Object storage. Current code supports OSS only.
DOCUMENT_STORAGE_PROVIDER=oss
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
OSS_BUCKET_NAME=replace-me
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_REGION=cn-shanghai
OSS_BASE_PREFIX=documents
OSS_PUBLIC_BASE_URL=

# TextIn OCR
TEXTIN_APP_ID=replace-me
TEXTIN_SECRET_CODE=replace-me
TEXTIN_API_URL=https://api.textin.com/ai/service/v1/pdf_to_markdown
TEXTIN_PARSE_MODE=auto
TEXTIN_GET_IMAGE=page
TEXTIN_TIMEOUT_SECONDS=120
DOCUMENT_OCR_AUTO_ENQUEUE=true

# OpenAI-compatible LLM
OPENAI_API_KEY=replace-me
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
METADATA_LLM_TIMEOUT_SECONDS=120
METADATA_LLM_TEMPERATURE=0
METADATA_LLM_ENABLE_RULE_FALLBACK=true
EACY_EXTRACTION_STRATEGY=claude_code
EXTRACTION_FIELD_BATCH_SIZE=35
EXTRACTION_OCR_EVIDENCE_UNIT_LIMIT=400
EXTRACTION_LLM_TIMEOUT_SECONDS=180
EXTRACTION_LLM_TEMPERATURE=0
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_WORKSPACE_ROOT=/tmp/eacy-claude-code
CLAUDE_CODE_TIMEOUT_SECONDS=300
CLAUDE_CODE_MAX_TURNS=14
CLAUDE_CODE_KEEP_WORKSPACE=false
CLAUDE_CODE_ALLOWED_TOOLS=Read,LS,Grep
CLAUDE_CODE_DISALLOWED_TOOLS=Bash,Edit,Write,WebFetch,WebSearch
CLAUDE_CODE_ENABLE_MCP_TOOLS=true
CLAUDE_CODE_MCP_SERVER_NAME=eacy_extraction
CLAUDE_CODE_BARE=false
CLAUDE_CODE_NO_SESSION_PERSISTENCE=true
CLAUDE_CODE_SESSION_NAME_PREFIX=eacy-extract
CLAUDE_CODE_CREDENTIALS_DIR=/root/.claude

# Runtime sizing
API_WORKERS=2
API_TIMEOUT_SECONDS=180
OCR_CONCURRENCY=2
METADATA_CONCURRENCY=2
EXTRACTION_CONCURRENCY=4
CLAUDE_CODE_CONCURRENCY=1
CELERY_MAX_TASKS_PER_CHILD=20
CELERY_WORKER_PREFETCH_MULTIPLIER=1
EXTRACTION_SCHEDULER_ENABLED=true
EXTRACTION_GLOBAL_CONCURRENCY=4
EXTRACTION_USER_CONCURRENCY=1
EXTRACTION_PROJECT_CONCURRENCY=2
EXTRACTION_SCHEDULER_BATCH_SIZE=20
EXTRACTION_SCHEDULER_INTERVAL_SECONDS=15
HTTP_PORT=80

# SMTP（注册/找回密码邮箱验证码）。腾讯/QQ 企业邮箱用授权码（不是登录密码）。
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=replace-me@yourdomain.com
SMTP_PASSWORD=replace-with-smtp-auth-code
SMTP_FROM=replace-me@yourdomain.com
SMTP_FROM_NAME=易悉 EACY
# 生产建议关掉 fallback；为 true 时 SMTP 未配置/失败会把验证码写日志并 200 返回。
VERIFICATION_CODE_DEBUG_FALLBACK=false

# China-friendly build mirrors. Override if your server has a faster registry.
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11.7-slim
NODE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
APT_MIRROR=https://mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_REGISTRY=https://registry.npmmirror.com
