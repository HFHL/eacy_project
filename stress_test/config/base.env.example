# 复制为 config/base.env 后填值；config/base.env 不入 git

# 公网域名（含 scheme，不要带尾斜杠）
EACY_BASE_URL=https://api.eacy.example.com

# 预置模板：要传 template_id 和它的某个 published schema_version_id
# 用 `python -m scripts.discover_templates` 列出后端已有模板/版本，挑一个 type=crf 的填这里
TEMPLATE_ID=tpl_xxx
TEMPLATE_VERSION_ID=ver_xxx

# 测试文档池：扁平目录，直接放 .pdf / .jpg / .jpeg / .png
# 每个 VU 启动时从池里随机抽 DOCS_PER_VU 份
FIXTURES_DIR=./fixtures
DOCS_PER_VU=5

# 业务步超时（秒）
STEP_TIMEOUT_OCR=300
STEP_TIMEOUT_EHR=300
STEP_TIMEOUT_CRF=480
