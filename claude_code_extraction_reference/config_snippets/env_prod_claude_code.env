CLAUDE_CODE_BIN=claude
CLAUDE_CODE_WORKSPACE_ROOT=/tmp/eacy-claude-code
CLAUDE_CODE_TIMEOUT_SECONDS=300
CLAUDE_CODE_MAX_TURNS=14
CLAUDE_CODE_KEEP_WORKSPACE=false
CLAUDE_CODE_ALLOWED_TOOLS=Read,LS,Grep
CLAUDE_CODE_DISALLOWED_TOOLS=Bash,Edit,Write,WebFetch,WebSearch
CLAUDE_CODE_ENABLE_MCP_TOOLS=true
CLAUDE_CODE_MCP_SERVER_NAME=eacy_extraction
CLAUDE_CODE_BARE=false
CLAUDE_CODE_NO_SESSION_PERSISTENCE=true
CLAUDE_CODE_SESSION_NAME_PREFIX=eacy-extract
# Host-side Claude Code credentials directory; mounted read-only to /home/eacy/.claude.
CLAUDE_CODE_CREDENTIALS_DIR=/root/.claude

# Runtime sizing
API_WORKERS=2
API_TIMEOUT_SECONDS=180
OCR_CONCURRENCY=2
METADATA_CONCURRENCY=2
EXTRACTION_CONCURRENCY=4
CLAUDE_CODE_CONCURRENCY=1
CELERY_MAX_TASKS_PER_CHILD=20
CELERY_WORKER_PREFETCH_MULTIPLIER=1
EXTRACTION_SCHEDULER_ENABLED=true
